{
  "name": "@bifrost/ui",
  "version": "0.64.1",
  "private": true,
  "description": "Shared monitoring shell — layout, tokens, Dense UI primitives for Bifrost Trade & Platform",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs",
    "prepare": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles": "./dist/styles/bifrost-ui.css",
    "./styles/semantic": "./dist/styles/semantic.css",
    "./styles/materials": "./dist/styles/materials.css",
    "./styles/patterns": "./dist/styles/patterns.css",
    "./styles/shell": "./dist/styles/shell.css",
    "./styles/layout": "./dist/styles/layout.css",
    "./layout": {
      "types": "./dist/adaptive/index.d.ts",
      "default": "./dist/adaptive/index.js"
    },
    "./city": {
      "types": "./dist/city/index.d.ts",
      "default": "./dist/city/index.js"
    },
    "./city/*": {
      "types": "./dist/city/*.d.ts",
      "default": "./dist/city/*.js"
    },
    "./communication": {
      "types": "./dist/communication/index.d.ts",
      "default": "./dist/communication/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "phaser": "^4.2.1",
    "radix-ui": "^1.4.3",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "phaser": "^4.2.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.6.0",
    "typescript": "^5.8.3"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "peerDependenciesMeta": {
    "phaser": {
      "optional": true
    }
  }
}
